# --- Telegram ---
# Токен бота от @BotFather. Без токена запустится только веб-панель.
TELEGRAM_TOKEN=

# --- LLM: любой OpenAI-совместимый /chat/completions с tool calling ---
# Claude (по умолчанию):
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1         LLM_MODEL=<модель с tool calling>
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1      LLM_MODEL=<провайдер/модель>
# Ollama:      LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=<модель>  (ключ не нужен)

# --- Семья ---
# Участники: telegram_id:Имя через запятую. Пусто — открытый режим:
# любой, кто напишет боту, попадает в семью (удобно для проверки).
FAMILY_MEMBERS=
APP_TIMEZONE=Europe/Moscow

# Демо-семья с тратами, чтобы панель не была пустой при первом запуске.
SEED_DEMO=true

# --- Эксплуатация ---
# Панель без авторизации, поэтому по умолчанию слушает только localhost.
# На удалённом сервере: PANEL_BIND=0.0.0.0 (и закройте доступ снаружи).
PANEL_BIND=127.0.0.1
PANEL_PORT=8080
# Если панель открывают по доменному имени (а не localhost/IP) — перечислите его,
# иначе запросы будут отклонены (защита от DNS rebinding).
PANEL_HOSTS=
MAX_CONCURRENCY=8
RATE_LIMIT_PER_HOUR=60
# debug — в логах видны вызовы инструментов агента с аргументами
LOG_LEVEL=info
